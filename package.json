{
  "name": "dsh-plugin-m10-mold-personal",
  "version": "0.2.11",
  "private": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "AI模具管理·个人版：node:sqlite 本地库、零外部依赖、单人离线、局域网多端。",
  "keywords": [
    "dsh-mold",
    "dsh-plugin",
    "deepseek-harness",
    "mold-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjj869849885/dsh-mold.git"
  },
  "type": "module",
  "exports": {
    ".": "./server/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "client.js",
    "server/",
    "locale/",
    "scripts/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {}
}
