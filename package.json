{
  "name": "dsh-plugin-m10-mold-personal",
  "version": "0.2.6",
  "private": true,
  "description": "AI模具管理·个人版：node:sqlite 本地库、零外部依赖、单人离线、局域网多端。",
  "type": "module",
  "exports": {
    ".": "./server/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {}
}
